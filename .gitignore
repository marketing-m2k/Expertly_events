__pycache__/
*.pyc
server.log
.env

# output/ holds the persisted scrape results -- these ARE committed after
# weekly GitHub Actions workflow so each run can reconcile against last
# week's data (e.g. fill in a date that was previously missing). Patterns
# (not per-country filenames) so adding a new country to weekly_full_run.py's
# COUNTRIES list needs no .gitignore change: output/raw/<Country>.xlsx and
# output/<Country>_2026.xlsx are picked up automatically.
# Per-run diagnostics (failures*.csv) are deliberately NOT whitelisted here --
# they're still generated during each run and used for the digest, and the
# workflow uploads them as a run artifact, but they don't need to clutter
# the repo with a commit every week.
output/*
!output/raw/
!output/raw/*.xlsx
!output/final/
!output/final/*.xlsx
!output/Master.xlsx
!output/summaries/
!output/summaries/*.json
!output/progress.json
!output/dashboard.html

# Local run logs
logs/
