# Copy this file to .env and fill in your key. .env is gitignored — it never
# gets committed. Get a key at https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional — override the model (defaults to gemini-3.1-flash-lite, the
# cheapest currently-supported model as of Aug 2026).
# GEMINI_MODEL=gemini-3.1-flash-lite
